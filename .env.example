# Gemini API key — used two ways:
#
# 1) SERVER-SIDE (production): set as a Supabase Edge Function secret so the
#    gemini-proxy function can call Gemini without the key ever reaching the
#    client. The public/production web build does NOT inline this key.
#      supabase secrets set GEMINI_API_KEY=your_real_key_here --project-ref <ref>
#
# 2) DEV-ONLY (client): Vite inlines this key ONLY in `npm run dev` builds so
#    the Live Voice crew chief works during local development. Get a key at
#    https://aistudio.google.com/apikey. Production builds (`npm run build`)
#    replace it with '' — it never ships in the deployed bundle.

GEMINI_API_KEY=

# Supabase — required for the leaderboard, cloud auth, and live stats.
# Create a project at supabase.com → Project Settings → API for these.
# The anon key is public/safe to ship (RLS + the submit-drive Edge Function
# enforce the real rules). Leave blank until configured; the app runs local-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=